# API
API_HOST=127.0.0.1
API_PORT=8000
DATA_DIR=./data
DATABASE_URL=sqlite:///./data/stonk.db

# Optional market-data providers
MASSIVE_API_KEY=
# ThetaData v3 runs through Theta Terminal's local REST server. The terminal
# consumes THETADATA_API_KEY; Stonk sends market-data requests only to localhost.
THETADATA_API_KEY=
THETADATA_BASE_URL=http://127.0.0.1:25503/v3
STONK_OPTIONS_PROVIDER=thetadata
THETADATA_TERMINAL_JAR=
THETADATA_JAVA_BIN=/opt/homebrew/opt/openjdk@21/bin/java

# Legacy ThetaData email/password values can still be used by Theta Terminal
# via its creds.txt workflow, but the Stonk v3 adapter does not transmit them.
THETADATA_USERNAME=
THETADATA_PASSWORD=

# AI is disabled unless explicitly selected.
STONK_LLM_PROVIDER=disabled

# Local OpenAI-compatible server (Ollama, LM Studio, or vLLM)
STONK_LOCAL_LLM_BASE_URL=http://127.0.0.1:11434/v1
STONK_LOCAL_LLM_MODEL=gpt-oss:20b

# Hosted provider (server-side only; never expose this through Vite)
OPENAI_API_KEY=
STONK_OPENAI_MODEL=gpt-5.6-luna

# Persistent background-job state
STONK_JOB_DB=./data/jobs.sqlite3
