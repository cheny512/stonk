# API
API_HOST=127.0.0.1
API_PORT=8000
DATA_DIR=./data
DATABASE_URL=sqlite:///./data/stonk.db

# Optional market-data providers
MASSIVE_API_KEY=
THETADATA_USERNAME=
THETADATA_PASSWORD=

# AI is disabled unless explicitly selected.
STONK_LLM_PROVIDER=disabled

# Local OpenAI-compatible server (Ollama, LM Studio, or vLLM)
STONK_LOCAL_LLM_BASE_URL=http://127.0.0.1:11434/v1
STONK_LOCAL_LLM_MODEL=gpt-oss:20b

# Hosted provider (server-side only; never expose this through Vite)
OPENAI_API_KEY=
STONK_OPENAI_MODEL=gpt-5.6-luna

# Persistent background-job state
STONK_JOB_DB=./data/jobs.sqlite3
